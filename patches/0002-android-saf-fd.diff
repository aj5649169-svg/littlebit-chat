@@ -459,6 +464,37 @@ struct llama_model * llama_model_init_from_user(
 struct llama_model * llama_model_load_from_file(
         const char * path_model,
         struct llama_model_params params) {
+#if defined(__ANDROID__)
+    // Android's Storage Access Framework hands the app a file descriptor that
+    // is exposed as /proc/self/fd/<N>. Re-opening that path with fopen() can
+    // lose the document provider's file description (FUSE, Android 11+), so
+    // duplicate the descriptor we already own instead and keep the exact
+    // seekable file description the caller passed us.
+    if (path_model != nullptr) {
+        static const std::string fd_prefix = "/proc/self/fd/";
+        const std::string path = path_model;
+        if (path.compare(0, fd_prefix.size(), fd_prefix) == 0) {
+            const int fd = std::atoi(path.c_str() + fd_prefix.size());
+            if (fd >= 0) {
+                FILE * file = fdopen(dup(fd), "rb");
+                if (file != nullptr) {
+                    if (fseek(file, 0, SEEK_SET) == 0) {
+                        std::vector<std::string> splits = {};
+                        struct llama_model * model = llama_model_load_from_file_impl(
+                                nullptr, nullptr, nullptr, std::string(), splits, file, params);
+                        fclose(file);
+                        return model;
+                    }
+                    LLAMA_LOG_WARN("%s: descriptor %d is not seekable, loading from the path instead\n", __func__, fd);
+                    fclose(file);
+                } else {
+                    LLAMA_LOG_WARN("%s: could not duplicate descriptor %d (%s), loading from the path instead\n",
+                            __func__, fd, strerror(errno));
+                }
+            }
+        }
+    }
+#endif
     std::vector<std::string> splits = {};
     return llama_model_load_from_file_impl(nullptr, nullptr, nullptr, path_model, splits, /*file*/ nullptr, params);
 }
