           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
+    if (!model.littlebit.empty()) {
+        auto it = model.littlebit.find(w);
+        if (it != model.littlebit.end()) {
+            auto apply_path = [&](const llama_littlebit_path & path) {
+                auto * scaled = ggml_mul(ctx0, cur, path.g);
+                auto * latent = ggml_mul_mat(ctx0, path.v, scaled);
+                auto * out    = ggml_mul_mat(ctx0, path.u, latent);
+                prec_policy.apply(latent);
+                prec_policy.apply(out);
+                return out;
+            };
+            auto * res = apply_path(it->second.primary);
+            if (it->second.residual.u) {
+                res = ggml_add(ctx0, res, apply_path(it->second.residual));
+            }
+            return w_s ? ggml_mul(ctx0, res, w_s) : res;
+        }
+    }
+
     // a Hadamard-folded weight reads the transformed input; a LoRA delta lives in the primal basis and reads `cur`
     ggml_tensor * cur_mm = build_hadamard_input(w, cur);
     ggml_tensor * res = ggml_mul_mat(ctx0, w, cur_mm);
